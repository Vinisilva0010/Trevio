# Copy to `.env` and fill in. `.env` is git-ignored: never commit real values.
# All values below are placeholders, not real credentials.

# --- Local Postgres (infra/docker-compose.yml) ---
POSTGRES_USER=trevio_dev
POSTGRES_PASSWORD=change-me-use-a-long-random-value
POSTGRES_DB=trevio_dev

# --- API server (api/) ---
# Required. Must match the values above.
DATABASE_URL=postgres://trevio_dev:change-me-use-a-long-random-value@127.0.0.1:5432/trevio_dev
# Optional. Default 127.0.0.1:8080
BIND_ADDR=127.0.0.1:8080
# Optional: error, warn, info, debug, trace. Default info
LOG_LEVEL=info
